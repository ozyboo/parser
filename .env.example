# Всё опционально: без .env приложение работает на встроенной базе
# (PGlite, данные в ./data/pg) и создаёт таблицы само.

# Внешний PostgreSQL — раскомментируй, если нужен настоящий серверный Postgres:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Как часто сервер сам парсит источники в фоне (минуты, 0 = выключить)
AUTO_PARSE_MINUTES=15
